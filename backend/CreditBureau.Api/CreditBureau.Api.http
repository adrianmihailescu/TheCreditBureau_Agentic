@baseUrl = http://localhost:5250
# After creating an application, replace this with its id from the response.
@newApplicationId = APP-REPLACE-ME

### Read SQL-backed demo data
GET {{baseUrl}}/api/demo/state

### List applications
GET {{baseUrl}}/api/applications

### Read an application
GET {{baseUrl}}/api/applications/APP-2026-001

### Create an application
POST {{baseUrl}}/api/applications
Content-Type: application/json

{
  "customerAccountId": "demo-customer",
  "bankId": "BNK-101",
  "brokerId": "BRK-201",
  "product": "Personal loan",
  "requestedAmount": 12000,
  "consentRecorded": true,
  "documentsProvided": ["Proof of identity", "Proof of income"]
}

### Approve the current configured step
POST {{baseUrl}}/api/applications/{{newApplicationId}}/workflow-decision
Content-Type: application/json

{
  "actorAccountId": "demo-broker",
  "decision": "Approved"
}

### Rejecting the current step stops the application
POST {{baseUrl}}/api/applications/{{newApplicationId}}/workflow-decision
Content-Type: application/json

{
  "actorAccountId": "demo-broker",
  "decision": "Rejected"
}

### Persist workflow settings
PUT {{baseUrl}}/api/workflow/limits
Content-Type: application/json

{
  "actorAccountId": "demo-administrator",
  "maximumApplicationAmount": 50000,
  "bankExposureCap": 150000,
  "requireConsent": true,
  "requiredDocuments": ["Proof of identity", "Proof of income"],
  "workflowSteps": ["Broker", "Bank", "Credit Bureau", "Credit Officer"]
}

### Missing application returns 404
GET {{baseUrl}}/api/applications/APP-NOT-FOUND
